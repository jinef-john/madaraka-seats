# Railway Postgres connection string
DATABASE_URL=postgresql://postgres:PASSWORD@host:PORT/railway

# Set to "false" to disable SSL (for local dev with Railway proxy)
DATABASE_SSL=true

# Server port (Railway sets this automatically)
PORT=3001

# Cron schedule for background refresh (default: every 5 minutes)
REFRESH_CRON=*/5 * * * *

# Optional secret for /api/admin/* endpoints
ADMIN_SECRET=

# Scraper tuning
SCRAPER_CONCURRENCY=20
SCRAPER_TIMEOUT=30
SCRAPER_RETRY=2

# Search cache TTL in milliseconds
CACHE_SEARCH_TTL_MS=30000

# CORS — comma-separated list of allowed origins, or * for all
ALLOWED_ORIGINS=*
